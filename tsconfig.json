{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["jest"],
    "baseUrl": ".",
    "paths": { "@lib/*": ["../../t/lib/*"] }
  },
  "include": ["src/**/*", "test/**/*"]
}
